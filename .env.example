# Local dev uses H2 in-memory by default and does not need these values.
# To point Spring Boot at Supabase PostgreSQL, copy this file to .env.local,
# fill the password locally, then run scripts/check-supabase.sh.

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.fzlrxfcdlbaiildwjkxo
SPRING_DATASOURCE_PASSWORD=replace_with_local_secret
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_PROFILES_ACTIVE=postgres
# PostgreSQL schema changes are applied by Flyway; do not set ddl-auto=update.
JWT_SECRET=replace_with_a_long_random_secret

# Direct DB string can also work on networks with IPv6 routing:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.fzlrxfcdlbaiildwjkxo.supabase.co:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres

VITE_API_BASE_URL=http://127.0.0.1:8080/api
APP_FRONTEND_BASE_URL=http://localhost:5173

# PayPal Checkout sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_MOCK_MODE=false

# Gemini API key for UC-63 smart availability assistant. Keep the real value in .env.local.
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=false
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_gmail_app_password"
FROM_EMAIL=your_email@gmail.com
FROM_NAME="GoalZone"
