@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class PaymentController <<controller>> {
    -paymentWorkflowService : PaymentWorkflowService
    -payPalCheckoutService : PayPalCheckoutService

    +createPayPalOrder(@PathVariable Long bookingId, @RequestBody ApiRequests.PayPalOrderCreate request) : Object
    +capturePayPalOrder(@PathVariable Long bookingId, @PathVariable String orderId, @RequestBody ApiRequests.PayPalOrderCapture request) : Object
    +cancelPayPalOrder(@PathVariable Long bookingId, @PathVariable String orderId) : Object
}

class PayPalCheckoutService <<service>> {
    -support : DemoSupportService
    -bookingWorkflowService : BookingWorkflowService

    +createOrder(bookingId : Long, request : ApiRequests.PayPalOrderCreate) : Map<String, Object>
    +captureOrder(bookingId : Long, orderId : String, request : ApiRequests.PayPalOrderCapture) : Map<String, Object>
    +cancelOrder(bookingId : Long, orderId : String) : Map<String, Object>
}

class DemoSupportService <<service>> {
    -bookingRepository : BookingRepository
    -userRepository : AppUserRepository
    -paymentRepository : PaymentRepository
    -notificationRepository : NotificationRepository
    -invoiceRepository : InvoiceRepository

    +getBooking(bookingId : Long) : Booking
    +getUser(userId : Long) : AppUser
    +parseEnum(enumType : Class<T>, value : String, fallback : T) : T
    +notifyUser(user : AppUser, booking : Booking, type : NotificationType, title : String, message : String) : void
    +generateInvoice(booking : Booking) : void
    +money(value : BigDecimal) : BigDecimal
    +isBlank(value : String) : boolean
    +badRequest(message : String) : ApiException
    +notFound(message : String) : ApiException
}

class "ApiRequests.PayPalOrderCreate" as PayPalOrderCreateDTO <<dto>> {
    -createdById : Long
    -paymentOption : String
}

class "ApiRequests.PayPalOrderCapture" as PayPalOrderCaptureDTO <<dto>> {
    -createdById : Long
}

interface BookingRepository <<repository>> {
    +findById(id : Long) : Optional<Booking>
}

interface AppUserRepository <<repository>> {
    +findById(id : Long) : Optional<AppUser>
}

interface PaymentRepository <<repository>> {
    +save(entity : Payment) : Payment
    +findByProviderOrderId(providerOrderId : String) : Optional<Payment>
    +findByProviderCaptureId(providerCaptureId : String) : Optional<Payment>
}

interface NotificationRepository <<repository>> {
    +save(entity : Notification) : Notification
}

interface InvoiceRepository <<repository>> {
    +findByBooking_BookingId(bookingId : Long) : Optional<Invoice>
    +save(entity : Invoice) : Invoice
}

class AuditEntity <<entity>> {
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
}

class Booking <<entity>> {
    -bookingId : Long
    -customer : AppUser
    -staff : AppUser
    -slot : Slot
    -bookingCode : String
    -status : BookingStatus
    -bookingSource : BookingSource
    -fieldPriceAmount : BigDecimal
    -serviceTotalAmount : BigDecimal
    -promotionDiscountAmount : BigDecimal
    -membershipDiscountAmount : BigDecimal
    -totalAmount : BigDecimal
    -depositAmount : BigDecimal
    -paidAmount : BigDecimal
    -remainingAmount : BigDecimal
    -cancellationFeeAmount : BigDecimal
    -refundableAmount : BigDecimal
    -note : String
    -confirmedAt : LocalDateTime
    -checkedInAt : LocalDateTime
    -completedAt : LocalDateTime
    -cancelledAt : LocalDateTime
    -expiredAt : LocalDateTime
}

class AppUser <<entity>> {
    -userId : Long
    -role : Role
    -fullName : String
    -email : String
    -phone : String
    -passwordHash : String
    -avatarUrl : String
    -dateOfBirth : LocalDate
    -address : String
    -status : AccountStatus
    -bookingRestricted : boolean
    -restrictionReason : String
    -lastLoginAt : LocalDateTime
    -emailVerified : boolean
    -emailVerificationToken : String
    -emailVerificationSentAt : LocalDateTime
    -passwordResetToken : String
    -passwordResetSentAt : LocalDateTime
}

class Payment <<entity>> {
    -paymentId : Long
    -booking : Booking
    -paymentCode : String
    -paymentOption : PaymentOption
    -paymentMethod : PaymentMethod
    -amount : BigDecimal
    -status : PaymentStatus
    -transactionCode : String
    -providerOrderId : String
    -providerCaptureId : String
    -providerStatus : String
    -currency : String
    -idempotencyKey : String
    -gatewayMessage : String
    -paidAt : LocalDateTime
    -expiredAt : LocalDateTime
    -createdBy : AppUser
}

class Notification <<entity>> {
    -notificationId : Long
    -user : AppUser
    -booking : Booking
    -payment : Payment
    -refund : Refund
    -notificationType : NotificationType
    -title : String
    -message : String
    -read : boolean
    -sentAt : LocalDateTime
    -createdAt : LocalDateTime
}

class Invoice <<entity>> {
    -invoiceId : Long
    -booking : Booking
    -invoiceCode : String
    -fieldAmount : BigDecimal
    -serviceAmount : BigDecimal
    -discountAmount : BigDecimal
    -totalAmount : BigDecimal
    -paidAmount : BigDecimal
    -remainingAmount : BigDecimal
    -refundAmount : BigDecimal
    -issuedAt : LocalDateTime
}

enum PaymentOption {
    + deposit
    + full
    + remaining
}

enum PaymentMethod {
    + cash
    + online_sandbox
    + paypal_sandbox
    + bank_transfer
}

enum PaymentStatus {
    + pending
    + paid
    + failed
    + expired
    + refunded
    + partially_refunded
}

enum BookingStatus {
    + pending
    + confirmed
    + checked_in
    + completed
    + cancelled
    + no_show
    + expired
    + rejected
}

enum NotificationType {
    + booking_confirmation
    + booking_reminder
    + cancellation
    + refund
    + payment
    + issue
    + system
}

' Relationships
PaymentController ..> PayPalCheckoutService
PaymentController ..> PayPalOrderCreateDTO
PaymentController ..> PayPalOrderCaptureDTO
PayPalCheckoutService ..> DemoSupportService
PayPalCheckoutService ..> PayPalOrderCreateDTO
PayPalCheckoutService ..> PayPalOrderCaptureDTO
DemoSupportService ..> BookingRepository
DemoSupportService ..> AppUserRepository
DemoSupportService ..> PaymentRepository
DemoSupportService ..> NotificationRepository
DemoSupportService ..> InvoiceRepository

BookingRepository --> Booking
AppUserRepository --> AppUser
PaymentRepository --> Payment
NotificationRepository --> Notification
InvoiceRepository --> Invoice
Payment --> Booking
Payment --> AppUser
Notification --> Booking
Notification --> AppUser
Invoice --> Booking
Booking -|> AuditEntity
AppUser -|> AuditEntity
Payment -|> AuditEntity
Invoice -|> AuditEntity
Payment --> PaymentOption
Payment --> PaymentMethod
Payment --> PaymentStatus
Booking --> BookingStatus
Notification --> NotificationType

@enduml
    +payPalConfig() : Object
    +config() : Map<String, Object>
