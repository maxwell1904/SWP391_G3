@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class PromotionReportController <<controller>> {
    -promotionReportService : PromotionReportService

    +applyPromotionPreview(@RequestBody ApiRequests.PromotionApply request) : Object
}

class BookingController <<controller>> {
    -bookingWorkflowService : BookingWorkflowService

    +checkoutPreview(@RequestBody ApiRequests.PromotionApply request) : Object
    +createBooking(@RequestBody ApiRequests.BookingCreate request) : Object
}

class "ApiRequests.PromotionApply" as PromotionApplyDTO <<dto>> {
    -customerId : Long
    -slotId : Long
    -promotionCode : String
    -bookingSource : String
    -services : List<ServiceSelection>
}

class "ApiRequests.BookingCreate" as BookingCreateDTO <<dto>> {
    -customerId : Long
    -staffId : Long
    -slotId : Long
    -bookingSource : String
    -promotionCode : String
    -services : List<ServiceSelection>
    -note : String
}

class PromotionReportService <<service>> {
    -support : DomainSupportService
    -bookingWorkflowService : BookingWorkflowService

    +applyPromotionPreview(request : ApiRequests.PromotionApply) : Map<String, Object>
}

class BookingWorkflowService <<service>> {
    -support : DomainSupportService

    +previewCheckout(request : ApiRequests.PromotionApply) : Map<String, Object>
    +createBooking(request : ApiRequests.BookingCreate) : Map<String, Object>
}

class DomainSupportService <<service>> {
    -promotionRepository : PromotionRepository
    -bookingPromotionRepository : BookingPromotionRepository

    +calculatePromotionDiscount(promotionCode : String, slot : Slot, baseAmount : BigDecimal, services : List<ServiceSelection>) : BigDecimal
    +saveBookingPromotion(booking : Booking, promotionCode : String, discount : BigDecimal) : void
}

interface PromotionRepository <<repository>> {
    +findByPromotionCodeIgnoreCase(promotionCode : String) : Optional<Promotion>
}

interface BookingPromotionRepository <<repository>> {
    +save(entity : BookingPromotion) : BookingPromotion
}

class Promotion <<entity>> {
    -promotionId : Long
    -promotionCode : String
    -promotionName : String
    -discountType : DiscountType
    -discountValue : BigDecimal
    -maxDiscountAmount : BigDecimal
    -minBookingAmount : BigDecimal
    -usageLimit : Integer
    -usedCount : int
    -startDate : LocalDate
    -endDate : LocalDate
    -applicableFieldType : FieldType
    -applicableExtraService : ExtraService
    -stackable : boolean
    -status : CommonStatus
}

class BookingPromotion <<entity>> {
    -bookingPromotionId : Long
    -booking : Booking
    -promotion : Promotion
    -promotionCodeSnapshot : String
    -discountAmount : BigDecimal
    -appliedAt : LocalDateTime
}

class Slot <<entity>> {
    -slotId : Long
    -field : FootballField
    -slotDate : LocalDate
    -startTime : LocalTime
    -endTime : LocalTime
}

class FootballField <<entity>> {
    -fieldId : Long
    -fieldType : FieldType
    -fieldName : String
}

class FieldType <<entity>> {
    -fieldTypeId : Long
    -typeName : String
}

class ExtraService <<entity>> {
    -extraServiceId : Long
    -serviceName : String
}

class AuditEntity <<entity>> {
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
}

enum DiscountType {
    + percent
    + fixed_amount
}

enum CommonStatus {
    + active
    + inactive
}

' Relationships
PromotionReportController ..> PromotionReportService
PromotionReportController ..> PromotionApplyDTO
BookingController ..> BookingWorkflowService
BookingController ..> PromotionApplyDTO
BookingController ..> BookingCreateDTO
PromotionReportService ..> BookingWorkflowService
PromotionReportService ..> DomainSupportService
BookingWorkflowService ..> DomainSupportService
DomainSupportService ..> PromotionRepository
DomainSupportService ..> BookingPromotionRepository
DomainSupportService ..> Promotion
DomainSupportService ..> BookingPromotion
DomainSupportService ..> Slot
DomainSupportService ..> ExtraService
PromotionRepository --> Promotion
BookingPromotionRepository --> BookingPromotion
Promotion --> FieldType
Promotion --> ExtraService
Promotion --> DiscountType
Promotion --> CommonStatus
BookingPromotion --> Promotion
BookingPromotion --> Booking
Slot --> FootballField
FootballField --> FieldType
Promotion -|> AuditEntity

@enduml
