@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class BookingController <<controller>> {
    -bookingWorkflowService : BookingWorkflowService

    +createBooking(request : ApiRequests.BookingCreate) : Object
}

class BookingWorkflowService <<service>> {
    -support : DomainSupportService

    +createBooking(request : ApiRequests.BookingCreate) : Map<String, Object>
    -createBookingInternal(request : ApiRequests.BookingCreate) : Map<String, Object>
    -resolveOperatingStaff(requestedStaffId : Long) : AppUser
}

class AccountService <<service>> {
    -support : DomainSupportService

    +walkInCustomers() : List<Map<String, Object>>
}

class DomainSupportService <<service>> {
    -bookingRepository : BookingRepository

    +validateSlotBookable(slot : Slot) : void
    +calculateFieldPrice(slot : Slot) : BigDecimal
    +calculateServiceTotal(selections : List<ServiceSelection>, slot : Slot, excludedBookingId : Long) : BigDecimal
    +calculateMembershipDiscount(customer : AppUser, baseAmount : BigDecimal, source : BookingSource) : BigDecimal
    +saveBookingServices(booking : Booking, selections : List<ServiceSelection>) : void
}

class "ApiRequests.BookingCreate" as BookingCreateDTO <<dto>> {
    -customerId : Long
    -staffId : Long
    -slotId : Long
    -bookingSource : String
    -promotionCode : String
    -services : List<ServiceSelection>
    -note : String
}

interface BookingRepository <<repository>> {
    +existsBySlotAndStatusIn(slot : Slot, statuses : Collection<BookingStatus>) : boolean
    +save(entity : Booking) : Booking
}

class Booking <<entity>> {
    -bookingId : Long
    -customer : AppUser
    -staff : AppUser
    -slot : Slot
    -bookingCode : String
    -status : BookingStatus
    -bookingSource : BookingSource
    -fieldPriceAmount : BigDecimal
    -serviceTotalAmount : BigDecimal
    -totalAmount : BigDecimal
    -paidAmount : BigDecimal
    -remainingAmount : BigDecimal
    -confirmedAt : LocalDateTime
}

class Slot <<entity>> {
    -slotId : Long
    -field : FootballField
    -slotDate : LocalDate
    -startTime : LocalTime
    -endTime : LocalTime
    -status : SlotStatus
}

BookingController ..> BookingWorkflowService
BookingController ..> BookingCreateDTO
BookingWorkflowService ..> BookingCreateDTO
BookingWorkflowService ..> DomainSupportService
AccountService ..> DomainSupportService
DomainSupportService ..> BookingRepository
BookingRepository --> Booking
Booking --> Slot
Booking --> AppUser

@enduml
