@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class AccountController <<controller>> {
    -accountService : AccountService

    +forgotPassword(@RequestBody ApiRequests.ForgotPassword request) : Object
    +validateResetToken(@RequestBody ApiRequests.ValidateResetToken request) : Object
    +resetPassword(@RequestBody ApiRequests.ResetPassword request) : Object
}

class AccountService <<service>> {
    -support : DemoSupportService
    -verificationEmailService : VerificationEmailService
    -passwordEncoder : BCryptPasswordEncoder

    +forgotPassword(request : ApiRequests.ForgotPassword) : Map<String, Object>
    +validateResetToken(request : ApiRequests.ValidateResetToken) : Map<String, Object>
    +resetPassword(request : ApiRequests.ResetPassword) : Map<String, Object>
    -issuePasswordReset(user : AppUser) : void
    -validatePassword(password : String, confirmPassword : String) : void
}

class DemoSupportService <<service>> {
    -userRepository : AppUserRepository

    +requireText(value : String, message : String) : void
    +clean(value : String) : String
    +getUser(userId : Long) : AppUser
    +badRequest(message : String) : ApiException
    +notFound(message : String) : ApiException
}

class VerificationEmailService <<service>> {
    -mailSender : JavaMailSender
    -frontendBaseUrl : String
    -fromEmail : String
    -fromName : String
    -smtpUsername : String

    +sendPasswordResetEmail(user : AppUser) : VerificationEmailDelivery
    +passwordResetLink(user : AppUser) : String
}

class "ApiRequests.ForgotPassword" as ForgotPasswordDTO <<dto>> {
    -email : String
}

class "ApiRequests.ValidateResetToken" as ValidateResetTokenDTO <<dto>> {
    -userId : Long
    -token : String
}

class "ApiRequests.ResetPassword" as ResetPasswordDTO <<dto>> {
    -userId : Long
    -token : String
    -newPassword : String
    -confirmPassword : String
}

class VerificationEmailDelivery <<dto>> {
    -sent : boolean
    -status : String
    -message : String
}

interface AppUserRepository <<repository>> {
    +findByEmail(email : String) : Optional<AppUser>
    +findById(id : Long) : Optional<AppUser>
    +save(entity : AppUser) : AppUser
}

class AuditEntity <<entity>> {
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
}

class AppUser <<entity>> {
    -userId : Long
    -fullName : String
    -email : String
    -phone : String
    -passwordHash : String
    -avatarUrl : String
    -dateOfBirth : LocalDate
    -address : String
    -status : AccountStatus
    -bookingRestricted : boolean
    -restrictionReason : String
    -lastLoginAt : LocalDateTime
    -emailVerified : boolean
    -emailVerificationToken : String
    -emailVerificationSentAt : LocalDateTime
    -passwordResetToken : String
    -passwordResetSentAt : LocalDateTime
}

' Relationships
AccountController ..> AccountService
AccountController ..> ForgotPasswordDTO
AccountController ..> ValidateResetTokenDTO
AccountController ..> ResetPasswordDTO
AccountService ..> ForgotPasswordDTO
AccountService ..> ValidateResetTokenDTO
AccountService ..> ResetPasswordDTO
AccountService ..> DemoSupportService
AccountService ..> VerificationEmailService
VerificationEmailService ..> VerificationEmailDelivery
DemoSupportService ..> AppUserRepository
DemoSupportService ..> AppUser
AppUserRepository --> AppUser
AppUser -|> AuditEntity

@enduml
