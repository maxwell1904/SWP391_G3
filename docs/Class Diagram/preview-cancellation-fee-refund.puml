@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class BookingController <<controller>> {
    -bookingWorkflowService : BookingWorkflowService

    +cancellationPreview(bookingId : Long) : Object
}

class BookingWorkflowService <<service>> {
    -support : DemoSupportService

    +previewCancellation(bookingId : Long) : Map<String, Object>
    -requireBookingVisible(booking : Booking) : void
}

class DemoSupportService <<service>> {
    -bookingRepository : BookingRepository
    -systemSettingRepository : SystemSettingRepository

    +getBooking(bookingId : Long) : Booking
    +calculateCancellationPreview(booking : Booking) : Map<String, Object>
    +settingDecimal(key : String, fallback : BigDecimal) : BigDecimal
    +money(value : BigDecimal) : BigDecimal
}

interface BookingRepository <<repository>> {
    +findById(id : Long) : Optional<Booking>
}

interface SystemSettingRepository <<repository>> {
    +findBySettingKey(settingKey : String) : Optional<SystemSetting>
}

class Booking <<entity>> {
    -bookingId : Long
    -customer : AppUser
    -slot : Slot
    -status : BookingStatus
    -paidAmount : BigDecimal
}

class Slot <<entity>> {
    -slotId : Long
    -slotDate : LocalDate
    -startTime : LocalTime
}

class SystemSetting <<entity>> {
    -settingId : Long
    -settingKey : String
    -settingValue : String
    -settingGroup : String
    -status : CommonStatus
}

BookingController ..> BookingWorkflowService
BookingWorkflowService ..> DemoSupportService
DemoSupportService ..> BookingRepository
DemoSupportService ..> SystemSettingRepository
BookingRepository --> Booking
SystemSettingRepository --> SystemSetting
Booking --> Slot

@enduml
