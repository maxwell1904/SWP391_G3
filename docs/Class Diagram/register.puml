@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class AccountController <<controller>> {
    -accountService : AccountService

    +register(@RequestBody ApiRequests.Register request) : Object
    +verifyEmail(@RequestBody ApiRequests.EmailVerification request) : Object
    +resendEmailVerification(@RequestBody ApiRequests.EmailVerificationResend request) : Object
}

class AccountService <<service>> {
    -support : DomainSupportService
    -verificationEmailService : VerificationEmailService
    -passwordEncoder : BCryptPasswordEncoder
    -jwtService : JwtService

    +register(request : ApiRequests.Register) : Map<String, Object>
    +verifyEmail(request : ApiRequests.EmailVerification) : Map<String, Object>
    +resendEmailVerification(request : ApiRequests.EmailVerificationResend) : Map<String, Object>
    -issueEmailVerification(user : AppUser) : void
    -validatePassword(password : String, confirmPassword : String) : void
}

class DomainSupportService <<service>> {
    -userRepository : AppUserRepository
    -roleRepository : RoleRepository
    -customerMembershipRepository : CustomerMembershipRepository

    +requireText(value : String, message : String) : void
    +clean(value : String) : String
    +badRequest(message : String) : ApiException
    +serverError(message : String) : ApiException
    +userSummary(user : AppUser) : Map<String, Object>
    +attachDefaultMembership(customer : AppUser) : CustomerMembership
}

class VerificationEmailService <<service>> {
    -mailSender : JavaMailSender
    -frontendBaseUrl : String
    -fromEmail : String
    -fromName : String
    -smtpUsername : String

    +sendVerificationEmail(user : AppUser) : VerificationEmailDelivery
    +verificationLink(user : AppUser) : String
}

class JwtService <<service>> {
    -secretKey : String
    -jwtExpiration : long

    +generateToken(subject : String) : String
}

class "ApiRequests.Register" as RegisterDTO <<dto>> {
    -fullName : String
    -email : String
    -phone : String
    -password : String
    -confirmPassword : String
}

class VerificationEmailDelivery <<dto>> {
    -sent : boolean
    -status : String
    -message : String
}

interface AppUserRepository <<repository>> {
    +findByEmail(email : String) : Optional<AppUser>
    +findByPhone(phone : String) : Optional<AppUser>
    +save(entity : AppUser) : AppUser
}

interface RoleRepository <<repository>> {
    +findByRoleName(roleName : String) : Optional<Role>
}

class AuditEntity <<entity>> {
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
}

class AppUser <<entity>> {
    -userId : Long
    -role : Role
    -fullName : String
    -email : String
    -phone : String
    -passwordHash : String
    -avatarUrl : String
    -dateOfBirth : LocalDate
    -address : String
    -status : AccountStatus
    -accountLocked : boolean
    -lockReason : String
    -lastLoginAt : LocalDateTime
    -emailVerified : boolean
    -emailVerificationToken : String
    -emailVerificationSentAt : LocalDateTime
    -passwordResetToken : String
    -passwordResetSentAt : LocalDateTime
}

class Role <<entity>> {
    -roleId : Long
    -roleName : String
    -description : String
    -status : CommonStatus
}

class CustomerMembership <<entity>> {
    -customerMembershipId : Long
    -customer : AppUser
    -membershipLevel : MembershipLevel
    -completedBookingCount : int
    -progressNote : String
    -effectiveFrom : LocalDate
    -effectiveTo : LocalDate
}

' Relationships
AccountController ..> AccountService
AccountController ..> RegisterDTO
AccountService ..> RegisterDTO
AccountService ..> DomainSupportService
AccountService ..> VerificationEmailService
AccountService ..> JwtService
VerificationEmailService ..> VerificationEmailDelivery
DomainSupportService ..> AppUserRepository
DomainSupportService ..> RoleRepository
DomainSupportService ..> CustomerMembership
AppUserRepository --> AppUser
RoleRepository --> Role
AppUser -|> AuditEntity
Role -|> AuditEntity
CustomerMembership -|> AuditEntity
CustomerMembership --> AppUser
AppUser --> Role

@enduml
