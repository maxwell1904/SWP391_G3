@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class BookingController <<controller>> {
    -bookingWorkflowService : BookingWorkflowService

    +reschedule(bookingId : Long, request : ApiRequests.BookingReschedule) : Object
}

class BookingWorkflowService <<service>> {
    -support : DomainSupportService

    +reschedule(bookingId : Long, request : ApiRequests.BookingReschedule) : Map<String, Object>
    -recalculatePromotionDiscount(booking : Booking, newSlot : Slot, baseAmount : BigDecimal) : BigDecimal
    -requireBookingVisible(booking : Booking) : void
}

class DomainSupportService <<service>> {
    -bookingRepository : BookingRepository
    -slotRepository : SlotRepository

    +getBooking(bookingId : Long) : Booking
    +getSlot(slotId : Long) : Slot
    +validateSlotBookable(slot : Slot) : void
    +calculateFieldPrice(slot : Slot) : BigDecimal
    +calculateMembershipDiscount(customer : AppUser, baseAmount : BigDecimal, source : BookingSource) : BigDecimal
    +remainingRefundEntitlement(booking : Booking, grossEntitlement : BigDecimal) : BigDecimal
    +generateInvoice(booking : Booking) : void
}

class "ApiRequests.BookingReschedule" as BookingRescheduleDTO <<dto>> {
    -newSlotId : Long
    -note : String
}

interface BookingRepository <<repository>> {
    +existsBySlotAndStatusIn(slot : Slot, statuses : Collection<BookingStatus>) : boolean
    +findById(id : Long) : Optional<Booking>
}

interface SlotRepository <<repository>> {
    +findById(id : Long) : Optional<Slot>
}

class Booking <<entity>> {
    -bookingId : Long
    -customer : AppUser
    -slot : Slot
    -status : BookingStatus
    -fieldPriceAmount : BigDecimal
    -totalAmount : BigDecimal
    -paidAmount : BigDecimal
    -remainingAmount : BigDecimal
    -refundableAmount : BigDecimal
}

class Slot <<entity>> {
    -slotId : Long
    -field : FootballField
    -slotDate : LocalDate
    -startTime : LocalTime
    -endTime : LocalTime
    -status : SlotStatus
}

BookingController ..> BookingWorkflowService
BookingController ..> BookingRescheduleDTO
BookingWorkflowService ..> BookingRescheduleDTO
BookingWorkflowService ..> DomainSupportService
DomainSupportService ..> BookingRepository
DomainSupportService ..> SlotRepository
BookingRepository --> Booking
SlotRepository --> Slot
Booking --> Slot

@enduml
