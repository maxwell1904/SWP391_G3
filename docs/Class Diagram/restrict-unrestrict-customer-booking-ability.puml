@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class AccountController <<controller>> {
    -accountService : AccountService

    +updateRestriction(userId : Long, request : ApiRequests.RestrictionUpdate) : Object
}

class AccountService <<service>> {
    -support : DemoSupportService
    -verificationEmailService : VerificationEmailService

    +updateRestriction(userId : Long, request : ApiRequests.RestrictionUpdate) : Map<String, Object>
    -requireAdmin() : void
    -revokeAllTokens(user : AppUser) : void
}

class VerificationEmailService <<service>> {
    +sendRestrictionEmail(user : AppUser, reason : String) : VerificationEmailDelivery
}

class "ApiRequests.RestrictionUpdate" as RestrictionUpdateDTO <<dto>> {
    -bookingRestricted : boolean
    -restrictionReason : String
}

interface AppUserRepository <<repository>> {
    +findById(id : Long) : Optional<AppUser>
    +save(entity : AppUser) : AppUser
}

class AppUser <<entity>> {
    -userId : Long
    -role : Role
    -email : String
    -status : AccountStatus
    -bookingRestricted : boolean
    -restrictionReason : String
    -authVersion : long
}

class Role <<entity>> {
    -roleId : Long
    -roleName : String
}

AccountController ..> AccountService
AccountController ..> RestrictionUpdateDTO
AccountService ..> RestrictionUpdateDTO
AccountService ..> VerificationEmailService
AccountService ..> AppUserRepository
VerificationEmailService ..> AppUser
AppUserRepository --> AppUser
AppUser --> Role

@enduml
