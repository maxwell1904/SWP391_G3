@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class FieldOperationController <<controller>> {
    -fieldOperationService : FieldOperationService

    +searchSlots(@RequestParam LocalDate date, @RequestParam Long fieldTypeId) : Object
}

class FieldOperationService <<service>> {
    -support : DomainSupportService
    -slotGenerationService : SlotGenerationService

    +searchSlots(date : LocalDate, fieldTypeId : Long) : List<Map<String, Object>>
}

class SlotGenerationService <<service>> {
    -support : DomainSupportService

    +ensureDate(date : LocalDate) : int
    +generateRollingWindow() : GenerationResult
    +rules() : SlotRules
    -generateForDate(date : LocalDate, rules : SlotRules) : int
}

class DomainSupportService <<service>> {
    -slotRepository : SlotRepository
    -fieldRepository : FootballFieldRepository
    -fieldPriceRepository : FieldPriceRepository
    -bookingRepository : BookingRepository
    -systemSettingRepository : SystemSettingRepository

    +calculateFieldPrice(slot : Slot) : BigDecimal
}

interface SlotRepository <<repository>> {
    +findBySlotDate(date : LocalDate) : List<Slot>
}

interface FootballFieldRepository <<repository>> {
    +findByStatus(status : CommonStatus) : List<FootballField>
}

interface FieldPriceRepository <<repository>> {
    +findByField_FieldId(fieldId : Long) : List<FieldPrice>
}

interface BookingRepository <<repository>> {
    +existsBySlotAndStatusIn(slot : Slot, statuses : Collection<BookingStatus>) : boolean
}

interface SystemSettingRepository <<repository>> {
    +findBySettingKey(settingKey : String) : Optional<SystemSetting>
}

class SystemSetting <<entity>> {
    -settingKey : String
    -settingValue : String
    -settingGroup : String
    -status : CommonStatus
}

class AuditEntity <<entity>> {
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
}

class Slot <<entity>> {
    -slotId : Long
    -field : FootballField
    -slotDate : LocalDate
    -startTime : LocalTime
    -endTime : LocalTime
    -status : SlotStatus
    -blockReason : String
    -blockNote : String
    -createdBy : AppUser
}

class FootballField <<entity>> {
    -fieldId : Long
    -fieldType : FieldType
    -fieldName : String
    -description : String
    -imageUrl : String
    -location : String
    -surfaceType : String
    -status : CommonStatus
}

class FieldType <<entity>> {
    -fieldTypeId : Long
    -typeName : String
    -playerCapacity : Integer
    -description : String
    -status : CommonStatus
}

class FieldPrice <<entity>> {
    -fieldPriceId : Long
    -field : FootballField
    -dayType : String
    -startTime : LocalTime
    -endTime : LocalTime
    -price : BigDecimal
    -effectiveFrom : LocalDate
    -effectiveTo : LocalDate
    -status : CommonStatus
}

enum CommonStatus {
    + active
    + inactive
}

enum SlotStatus {
    + available
    + blocked
}

' Relationships
FieldOperationController ..> FieldOperationService
FieldOperationService ..> SlotGenerationService
FieldOperationService ..> DomainSupportService
SlotGenerationService ..> DomainSupportService
DomainSupportService ..> SlotRepository
DomainSupportService ..> FootballFieldRepository
DomainSupportService ..> BookingRepository
DomainSupportService ..> FieldPriceRepository
DomainSupportService ..> SystemSettingRepository
DomainSupportService ..> Slot
DomainSupportService ..> FootballField
DomainSupportService ..> FieldPrice
SlotRepository --> Slot
FootballFieldRepository --> FootballField
BookingRepository --> Booking
FieldPriceRepository --> FieldPrice
SystemSettingRepository --> SystemSetting
SystemSetting --> CommonStatus
Slot --> FootballField
FootballField --> FieldType
FieldPrice --> FootballField
FootballField --> CommonStatus
Slot --> SlotStatus
Slot -|> AuditEntity
FootballField -|> AuditEntity
FieldType -|> AuditEntity
FieldPrice -|> AuditEntity

@enduml
