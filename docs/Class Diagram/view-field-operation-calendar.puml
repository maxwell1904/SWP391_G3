@startuml
skinparam classAttributeIconSize 0
skinparam linetype polyline

class FieldOperationController <<controller>> {
  -fieldOperationService : FieldOperationService
  +operationCalendar(date : LocalDate) : Object
}
class FieldOperationService <<service>> {
  -support : DemoSupportService
  +operationCalendar(date : LocalDate) : List<Map<String, Object>>
  -requireOperator() : void
}
class DemoSupportService <<service>> {
  -slotRepository : SlotRepository
  -bookingRepository : BookingRepository
  +slotSummary(slot : Slot) : Map<String, Object>
  +bookingSummary(booking : Booking) : Map<String, Object>
}
interface SlotRepository <<repository>> {
  +findBySlotDate(slotDate : LocalDate) : List<Slot>
}
interface BookingRepository <<repository>> {
  +findBySlot_SlotDateOrderBySlot_StartTimeAsc(slotDate : LocalDate) : List<Booking>
}
class Slot <<entity>> {
  -slotId : Long
  -slotDate : LocalDate
  -startTime : LocalTime
  -endTime : LocalTime
  -status : SlotStatus
}
class Booking <<entity>> {
  -bookingId : Long
  -bookingCode : String
  -status : BookingStatus
  -slot : Slot
}
FieldOperationController ..> FieldOperationService
FieldOperationService ..> DemoSupportService
DemoSupportService ..> SlotRepository
DemoSupportService ..> BookingRepository
SlotRepository --> Slot
BookingRepository --> Booking
Booking --> Slot
@enduml
