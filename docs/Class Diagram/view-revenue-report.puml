@startuml

skinparam classAttributeIconSize 0
skinparam linetype polyline

class PromotionReportController <<controller>> {
    -promotionReportService : PromotionReportService

    +reports() : Object
}

class PromotionReportService <<service>> {
    -support : DomainSupportService

    +reports() : Map<String, Object>
}

class DomainSupportService <<service>> {
    -bookingRepository : BookingRepository
    -paymentRepository : PaymentRepository
    -userRepository : AppUserRepository

    +money(value : BigDecimal) : BigDecimal
}

interface BookingRepository <<repository>> {
    +findAll() : List<Booking>
    +findByCustomer_UserIdOrderByBookingIdDesc(customerId : Long) : List<Booking>
}

interface PaymentRepository <<repository>> {
    +findAll() : List<Payment>
}

interface AppUserRepository <<repository>> {
    +findAll() : List<AppUser>
}

class Booking <<entity>> {
    -bookingId : Long
    -slot : Slot
    -status : BookingStatus
}

class Payment <<entity>> {
    -paymentId : Long
    -amount : BigDecimal
    -providerFeeAmount : BigDecimal
    -providerNetAmount : BigDecimal
    -status : PaymentStatus
}

class AppUser <<entity>> {
    -userId : Long
    -fullName : String
    -role : Role
}

class Slot <<entity>> {
    -slotId : Long
    -field : FootballField
}

class FootballField <<entity>> {
    -fieldId : Long
    -fieldName : String
}

class Role <<entity>> {
    -roleId : Long
    -roleName : String
}

enum BookingStatus {
    + pending
    + confirmed
    + checked_in
    + completed
    + cancelled
    + no_show
    + expired
    + rejected
}

enum PaymentStatus {
    + pending
    + paid
    + failed
    + expired
    + refunded
    + partially_refunded
}

' Relationships
PromotionReportController ..> PromotionReportService
PromotionReportService ..> DomainSupportService
DomainSupportService ..> BookingRepository
DomainSupportService ..> PaymentRepository
DomainSupportService ..> AppUserRepository
DomainSupportService ..> Booking
DomainSupportService ..> Payment
DomainSupportService ..> AppUser
BookingRepository --> Booking
PaymentRepository --> Payment
AppUserRepository --> AppUser
Booking --> Slot
Slot --> FootballField
AppUser --> Role
Booking --> BookingStatus
Payment --> PaymentStatus

@enduml
