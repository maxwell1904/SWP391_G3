@startuml

actor Admin
participant "Admin UI" as UI
participant AccountController as Controller
participant AccountService as Service
participant DemoSupportService as Support
participant VerificationEmailService as Email
database PostgreSQL as DB

Admin -> UI : Select customer and choose Lock
UI -> UI : Require lock reason
UI -> Controller : PUT /api/account/users/{id}/lock\n{accountLocked: true, lockReason}
Controller -> Service : updateAccountLock(userId, request)
Service -> Support : getUser(userId)
Support -> DB : SELECT app_user
DB --> Support : customer
Support --> Service : AppUser
Service -> Service : Validate Customer role and reason
Service -> Service : status = locked\naccountLocked = true\nlockReason = reason\nauthVersion++
Service -> Email : sendAccountLockEmail(customer, reason)
Email --> Service : delivery status
Service -> DB : COMMIT account lock
Service --> Controller : locked customer summary
Controller --> UI : HTTP 200
UI --> Admin : Show account locked

group Locked customer attempts login
  UI -> Controller : POST /api/account/login
  Controller -> Service : login(credentials)
  Service -> DB : Find account
  DB --> Service : accountLocked = true
  Service --> Controller : HTTP 403\nCheck email for details
  Controller --> UI : Login blocked
end

group Admin unlocks customer
  Admin -> UI : Choose Unlock
  UI -> Controller : PUT /api/account/users/{id}/lock\n{accountLocked: false}
  Controller -> Service : updateAccountLock(userId, request)
  Service -> Service : status = active\naccountLocked = false\nlockReason = null\nauthVersion++
  Service -> DB : COMMIT account unlock
  Service --> Controller : active customer summary
  Controller --> UI : HTTP 200
end

@enduml
