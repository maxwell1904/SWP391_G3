@startuml

skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BackgroundColor white
  BorderColor black
}

actor "Staff" as User
participant "BookingPage" as UI
participant "App.jsx" as App
participant "BookingController / PaymentController" as Controller
participant "BookingWorkflowService / PaymentWorkflowService" as Service
participant "BookingRepository / PaymentRepository" as Repo
database "Database" as DB

== UC-25: Create walk-in booking ==

User -> UI : 1. Search phone/email or choose First-time visitor
activate User
activate UI

alt Registered Customer is matched
  UI -> App : 2. Select matched Customer account
else First-time visitor
  UI -> App : 2. Enter name, phone, optional email
end
activate App

App -> App : 3. Validate one customer identity and build request
activate App
deactivate App

alt Pay later
  App -> Controller : 4. POST /api/bookings
else Deposit or full cash
  App -> Controller : 4. POST /api/payments/walk-in-checkout
end
activate Controller

Controller -> Service : 5. createBooking(request) / createWalkInAndCapture(request)
activate Service

Service -> Service : 6. Staff role; account-or-guest identity; slot and cash rules
activate Service
deactivate Service

alt Request is valid and authorized
  Service -> Repo : 7. save(booking); save(payment)
  activate Repo

  Repo -> DB : 8. INSERT booking; optionally INSERT payment; UPSERT invoice
  activate DB
  DB --> Repo : 9. Pending pay-later or confirmed cash booking
  deactivate DB

  Repo --> Service : 10. Repository result
  deactivate Repo

  Service -> Service : 11. Assign Staff; guest gets no membership;\noptionally capture deposit/full cash
  activate Service
  deactivate Service
else Validation, authorization, or state rule fails
  note over Service,Controller
    Missing guest phone, slot conflict, or invalid cash -> HTTP 400
    The service propagates ApiException to ApiExceptionHandler.
  end note
end

Service --> Controller : 12. Domain result or propagated error
deactivate Service

Controller -> Controller : 13. Serialize response
activate Controller
deactivate Controller

Controller --> App : 14. HTTP 200 or mapped 4xx\nresponse body or error payload
deactivate Controller

App -> App : 15. setSelectedBookingDetail; clear checkout draft
activate App
deactivate App

App --> UI : 16. Navigate to Staff workspace
deactivate App

UI --> User : 17. Updated screen or error feedback

deactivate UI
deactivate User

@enduml
