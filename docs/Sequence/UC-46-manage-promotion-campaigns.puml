@startuml

skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BackgroundColor white
  BorderColor black
}

actor "Admin" as Actor
participant "PromotionsPage" as UI
participant "App.jsx" as App
participant "PromotionReportController" as Controller
participant "PromotionReportService" as Service
participant "PromotionRepository" as Repo
database "Database" as DB

== UC-46: Manage promotion campaigns ==

Actor -> UI : 1. Create or save campaign
activate Actor
activate UI

UI -> App : 2. createPromotion(payload) / updatePromotion(id, payload)
activate App

App -> Controller : 3. POST /api/promotions or PUT /api/promotions/{id}
activate Controller

Controller -> Service : 4. createPromotion(request) / updatePromotion(id, request)
activate Service

Service -> Repo : 5. findByPromotionCodeIgnoreCase(code)
activate Repo

Repo -> DB : 6. SELECT promotion WHERE UPPER(code)=UPPER(?)
activate DB
DB --> Repo : 7. Current record(s)
deactivate DB
Repo --> Service : 8. Domain object(s)
deactivate Repo

Service -> Service : 9. Require Admin\nvalidatePromotionRequest()\nunique code/date/discount rules
activate Service
deactivate Service

alt Validation fails
  Service -> Service : 10. Build ApiException
  activate Service
  deactivate Service
else Validation succeeds
  Service -> Repo : 10. save(promotion)
  activate Repo
  Repo -> DB : 11. INSERT or UPDATE promotion
  activate DB
  DB --> Repo : 12. Saved row(s)
  deactivate DB
  Repo --> Service : 13. Saved domain object
  deactivate Repo
end

Service --> Controller : 14. promotionSummary or error
deactivate Service

Controller --> App : 15. HTTP response
deactivate Controller

App -> App : 16. refreshAll()
activate App
deactivate App

App --> UI : 17. Refresh promotion catalogue
deactivate App

UI --> Actor : 18. Show created/updated campaign
deactivate UI
deactivate Actor

@enduml
