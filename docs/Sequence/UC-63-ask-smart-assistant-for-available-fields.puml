@startuml

skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Customer or Guest" as Actor
participant "AvailabilityAssistantPage" as UI
participant "FieldOperationController" as Controller
participant "FieldOperationService" as Service
participant "SlotRepository" as SlotRepo
participant "BookingRepository" as BookingRepo
database "Database" as DB

== Ask availability assistant ==

Actor -> UI : 1. Enter date, preferred time, type and budget
activate Actor
activate UI
UI -> Controller : 2. GET /api/slots/suggestions?criteria
activate Controller
Controller -> Service : 3. suggestSlots(criteria)
activate Service
Service -> Service : 4. Validate date, budget and customer identity
activate Service
deactivate Service

alt Criteria are valid
  Service -> SlotRepo : 5. findBySlotDate(date)
  activate SlotRepo
  SlotRepo -> DB : 6. SELECT slots and fields for date
  activate DB
  DB --> SlotRepo : 7. Candidate slots
  deactivate DB
  SlotRepo --> Service : 8. List<Slot>
  deactivate SlotRepo
  Service -> BookingRepo : 9. Check active reservation for each candidate
  activate BookingRepo
  BookingRepo -> DB : 10. EXISTS active booking by slot
  activate DB
  DB --> BookingRepo : 11. Reservation flags
  deactivate DB
  BookingRepo --> Service : 12. Availability results
  deactivate BookingRepo
  Service -> Service : 13. Filter and rank explainable suggestions
  activate Service
  deactivate Service
  Service --> Controller : 14. Ranked suggestions with reasons
else Invalid or unauthorized criteria
  Service --> Controller : 14. ApiException
end
deactivate Service
Controller --> UI : 15. HTTP response
deactivate Controller
UI --> Actor : 16. Show live suggestions or corrective message
deactivate UI
deactivate Actor

@enduml
