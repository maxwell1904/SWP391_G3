@startuml
title GoalZone - Admin configuration use cases
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #B45309
  ArrowColor #475569
}

actor Admin

rectangle GoalZone {
  package "Accounts" #EFF6FF {
    usecase "UC-07\nView and lock/unlock Customers" as UC07
    usecase "UC-08\nManage Staff accounts" as UC08
    usecase "UC-09\nView Customer activity" as UC09
  }
  package "Venue catalogue & policy" #ECFDF5 {
    usecase "UC-13\nManage fields" as UC13
    usecase "UC-14\nManage field pricing" as UC14
    usecase "UC-15\nConfigure slot rules" as UC15
    usecase "UC-17\nManage extra services" as UC17
    usecase "UC-48\nConfigure deposit rules" as UC48
    usecase "UC-49\nConfigure cancellation policy" as UC49
  }
  package "Commercial rules" #FFF7ED {
    usecase "UC-51\nManage promotions" as UC51
    usecase "UC-54\nManage membership rules" as UC54
  }
}

Admin --> UC07
Admin --> UC08
Admin --> UC09
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC17
Admin --> UC48
Admin --> UC49
Admin --> UC51
Admin --> UC54

note bottom
Admin configures the venue. Admin does not perform Staff-only check-in,
completion, no-show, counter-payment or issue-resolution actions.
end note
@enduml
